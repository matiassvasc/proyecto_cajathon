# ==============================================================================
# KipuAI — CAJATHON 2026 (Desafío NEG-01: Caja Trujillo)
# Copia este archivo a `.env.local` para activar la IA en vivo con Google Gemini.
# Si `GEMINI_API_KEY` está vacía o ausente, KipuAI usa automáticamente su motor
# determinista calibrado para que la demostración nunca falle sin conexión.
# ==============================================================================

# Clave de API de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo oficial recomendado del SDK @google/genai (>= 3.5)
GEMINI_MODEL=gemini-4-hydrogen
